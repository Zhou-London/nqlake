# Lakehouse stack configuration.

# --- Images ---
# Absolute path of the directory holding the lakehouse-* Dockerfiles (the
# parent repository's Dockerfiles/). compose.yaml builds every image from it.
DOCKERFILES_DIR=/Users/zhou/Containers/Dockerfiles

# --- Ports ---
# Each service listens on its port inside the container and publishes the
# same port on the host. The block 40000-40004 stays clear of the usual
# defaults (5432, 8080, 9000) and of the ephemeral range.
MINIO_API_PORT=40000
# Port of the Next.js console; `make up` starts it on the host.
CONSOLE_PORT=40001
LAKEKEEPER_PORT=40002
POSTGRES_PORT=40003
# Port of the backend API; `make up` starts it on the host.
API_PORT=40004

# --- Backend API ---
# Interface and port the backend binds when POST /query/arrow is called; the
# receiver connects to this machine on that port and reads the result as an
# Arrow IPC stream, and DELETE /query/arrow abandons while nobody has
# connected. A request body can name another port, or 0 for any free one.
# The stream has no authentication: 0.0.0.0 lets any machine that can reach
# this one read the result, 127.0.0.1 keeps it to local receivers.
ARROW_HOST=0.0.0.0
ARROW_PORT=40005

# --- MinIO (object store) ---
MINIO_ROOT_USER=lakehouse-root
MINIO_ROOT_PASSWORD=change-me

# MinIO user Lakekeeper uses for S3 access and STS credential vending. It
# cannot be root: MinIO refuses AssumeRole for root.
LAKEHOUSE_S3_ACCESS_KEY=lakekeeper
LAKEHOUSE_S3_SECRET_KEY=change-me

# Bucket holding all Iceberg data and metadata.
LAKEHOUSE_BUCKET=lakehouse

# --- Postgres (catalog metadata) ---
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lakekeeper

# --- Lakekeeper (Iceberg REST catalog) ---
# Key Lakekeeper uses to encrypt storage credentials before storing them in
# Postgres.
LAKEKEEPER_PG_ENCRYPTION_KEY=change-me

# Name of the warehouse in the catalog. The backend API and DuckDB attach the
# catalog by this name.
LAKEHOUSE_WAREHOUSE=lakehouse
