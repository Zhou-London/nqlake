# Local credentials. Copy .env.example to .env before `make up`.
.env

# Bind-mounted service data under images/<service>/.
images/*/data/
images/*/work/
images/*/state/
images/duckdb/extensions/

# The uv-managed Python environment (`make up` creates it from uv.lock).
.venv/

*.duckdb
*.duckdb.wal
__pycache__/
.DS_Store

# Next.js console build output and dependencies.
console/node_modules/
console/.next/
console/*.tsbuildinfo
