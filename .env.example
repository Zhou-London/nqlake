# Lakehouse stack configuration. Copy to .env and set your own secrets — the
# values below are placeholders, not defaults to ship.

# --- MinIO (object store) ---
MINIO_ROOT_USER=lakehouse-root
MINIO_ROOT_PASSWORD=change-me

# Non-root user Lakekeeper uses for S3 access and STS credential vending.
LAKEHOUSE_S3_ACCESS_KEY=lakekeeper
LAKEHOUSE_S3_SECRET_KEY=change-me

# Bucket holding all Iceberg data and metadata.
LAKEHOUSE_BUCKET=lakehouse

# --- Postgres (catalog metadata) ---
POSTGRES_USER=lakekeeper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lakekeeper

# --- Lakekeeper (Iceberg REST catalog) ---
# Encrypts storage credentials at rest in Postgres.
LAKEKEEPER_PG_ENCRYPTION_KEY=change-me

# Warehouse name; also the name DuckDB attaches (see sql/attach.sql).
LAKEHOUSE_WAREHOUSE=lakehouse
